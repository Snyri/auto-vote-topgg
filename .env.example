# Local run only: copy to .env, then fill values. This file contains examples only.
# Entry points: python vote.py or python anigame_vote.py
# Read-only inspection: python anigame_vote.py --inspect
# The existing Discord account token is used for AniGame's Discord sign-in.
TOKENS=your-discord-token-here

# Optional: one AniGame cookie JSON array per account, on one line.
# Top.gg cookies are not used for AniGame. Current-machine verification cookies
# stay with the running browser and are not imported from an export.
#ANIGAME_COOKIES_JSON=[{"name":"session-cookie-name","value":"...","domain":".anigame.gg","path":"/","secure":true,"httpOnly":true}]

# Optional multiline credential files kept outside the repository.
# TOKENS_FILE: one account token per line; cookies: one JSON array per account.
#TOKENS_FILE=/absolute/private/path/accounts.txt
#ANIGAME_COOKIES_JSON_FILE=/absolute/private/path/cookies.jsonl

# Optional Telegram report
#TG_BOT_TOKEN=123456:AA-your-bot-token
#TG_CHAT_ID=your-chat-id

# Optional local debugging
#DEBUG=1
#SEND_ERROR_SCREENSHOTS=1

