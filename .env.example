# Local run only — copy this file to .env (ignored by Git), then fill values.
# Run: python vote.py
# The local .env reader supports single-line values only.

# One account token. For multiple accounts, use TOKENS_FILE below.
TOKENS=your-discord-token-here

# One 17-20 digit Discord bot snowflake.
# For multiple bots, set a multiline BOT_IDS environment variable before launch.
BOT_IDS=830530156048285716

# Optional: top.gg Auth.js cookie export for this account (one JSON array).
#TOPGG_COOKIES_JSON=[{"name":"__Secure-authjs.session-token","value":"...","domain":".top.gg","path":"/","secure":true,"httpOnly":true,"sameSite":"Lax"}]

# Optional multiline credential files, outside the repository and kept private.
# When set, these replace the corresponding inline values above.
# TOKENS_FILE: one token per line; cookies: one JSON array line per account.
#TOKENS_FILE=/absolute/private/path/accounts.txt
#TOPGG_COOKIES_JSON_FILE=/absolute/private/path/cookies.jsonl

# Optional Telegram report
#TG_BOT_TOKEN=123456:AA-your-bot-token
#TG_CHAT_ID=your-chat-id

# Optional local debugging
#DEBUG=1
#SEND_ERROR_SCREENSHOTS=1
